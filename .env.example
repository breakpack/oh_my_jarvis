# PostgreSQL (host port 5433 — 5432 is often taken by other local projects)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/personal_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_ai

# Redis (host port 6380 — 6379 is often taken by other local projects)
REDIS_URL=redis://localhost:6380/0

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LOCAL_FAST_MODEL=gemma4:e2b
OLLAMA_LOCAL_DEEP_MODEL=qwen3.6:27b-mlx
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# Cloud (optional, only used when user opts in via /cloud)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# API (host port 8010 — 8000/8001 are often taken by other local projects)
API_HOST=0.0.0.0
API_PORT=8010
LOG_LEVEL=INFO

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010

# Development Agent (Phase 6) — comma-separated absolute paths of repos the
# agent is allowed to open as a workspace. Empty means nothing is allowed.
# ALLOWED_REPOS=/absolute/path/to/repo-one,/absolute/path/to/repo-two
# WORKSPACE_BASE_DIR=/Users/you/PersonalAI/workspaces

# Proactive Assistant (Phase 9)
# PROACTIVE_GITHUB_REPOS=owner/repo-one,owner/repo-two   # empty = CI-failure source does nothing
# PROACTIVE_CHECK_INTERVAL_SECONDS=300   # hard floor of 60s regardless of this value
# QUIET_HOURS_START=22   # 0-23, local hour; unset = no quiet hours
# QUIET_HOURS_END=8

# Skill Store (Phase 10) — where installed skill versions are archived for rollback
# SKILL_STORE_BASE_DIR=/Users/you/PersonalAI/skill_store

# Telegram bot client — get a token from @BotFather, and your numeric user id
# from @userinfobot. The bot refuses to start without both; only this one
# user id is ever allowed to control the assistant via Telegram.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_ID=
