{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "web-read output",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "summary": { "type": "string" },
    "data": {
      "type": ["object", "null"],
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "error": { "type": ["string", "null"] }
  },
  "required": ["success", "summary"]
}
