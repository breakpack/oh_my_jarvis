{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codebase-orientation output",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "summary": { "type": "string" },
    "data": {
      "type": ["object", "null"],
      "properties": {
        "top_level_entries": { "type": "array", "items": { "type": "string" } },
        "file_sample": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "matched_by": { "type": "string", "enum": ["filename", "content"] }
            }
          }
        },
        "readme_path": { "type": ["string", "null"] },
        "readme_excerpt": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "error": { "type": ["string", "null"] }
  },
  "required": ["success", "summary"]
}
