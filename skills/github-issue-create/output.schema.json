{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "github-issue-create output",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "summary": { "type": "string" },
    "data": {
      "type": ["object", "null"],
      "properties": {
        "number": { "type": "integer" },
        "url": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "rollback_token": {
      "type": ["string", "null"],
      "description": "JSON-encoded {\"repo\": string, \"issue_number\": integer}, consumed by rollback() to close the created issue"
    },
    "error": { "type": ["string", "null"] }
  },
  "required": ["success", "summary"]
}
